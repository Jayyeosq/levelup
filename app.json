{
  "expo": {
    "name": "LevelUp+",
    "slug": "levelup-plus",
    "scheme": "levelup",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0F13",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.levelupplus.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.levelupplus.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E0F13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LevelUp+ uses your location to track your runs and claim territory.",
          "locationAlwaysAndWhenInUsePermission": "Allow LevelUp+ to keep tracking your run while your screen is locked.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "LevelUp+ reads your running workouts (distance, time and route) to award XP, claim map tiles and rank you on leaderboards.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "expo-dev-client"
    ],
    "extra": {
      "stravaAuthServer": "https://xmaioptoygjbcrwhszkk.supabase.co/functions/v1/strava-auth",
      "supabaseUrl": "https://xmaioptoygjbcrwhszkk.supabase.co",
      "supabaseKey": "sb_publishable_vQdKtCOucFDtPJrHH_hsOw_sCbjSzmC",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "588764b1-0629-460f-a7bd-5ff371302e44"
      }
    },
    "owner": "jayyeosq"
  }
}
